 "wallets": {
  "Winnow": {
   "app_source": "winnow",
   "code": {
    "app": ["winnow:Sources/WinnowApp", "winnow:Sources/WinnowLightningApp"],
    "bitcoin": ["winnow:Sources/WalletCore"],
    "lightning": ["winnow:Sources/LightningCore"]
   },
   "deps": {"spm": "winnow:Package.resolved"},
   "complete": ["winnow:Sources"]
  },
  "Phoenix": {
   "app_source": "phoenix",
   "code": {
    "app": ["phoenix:phoenix-ios/phoenix-ios", "phoenix:phoenix-ios/phoenix-notifySrvExt", "phoenix:phoenix-shared/src"],
    "lightning": ["lightning-kmp:modules"]
   },
   "deps": {
    "spm": "phoenix:phoenix-ios/phoenix-ios.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved",
    "maven": {
     "target": "ios_arm64",
     "engine": "fr.acinq.lightning:lightning-kmp-core",
     "roots": [
      "fr.acinq.lightning:lightning-kmp-core:{lightningkmp}",
      "org.jetbrains.kotlinx:kotlinx-serialization-cbor:{serialization}",
      "app.cash.sqldelight:runtime:{sqldelight}",
      "app.cash.sqldelight:coroutines-extensions:{sqldelight}",
      "co.touchlab.skie:configuration-annotations:{skie}",
      "app.cash.sqldelight:native-driver:{sqldelight}"
     ],
     "catalog": "phoenix:gradle/libs.versions.toml"
    }
   }
  },
  "Bitkit": {
   "app_source": "bitkit",
   "code": {
    "app": ["bitkit:Bitkit", "bitkit:BitkitNotification", "bitkit:BitkitWidget"],
    "lightning": [
     "synonym-ldk-node:src",
     "rust-lightning:lightning/src",
     "rust-lightning:lightning-types/src",
     "rust-lightning:lightning-invoice/src",
     "rust-lightning:lightning-net-tokio/src",
     "rust-lightning:lightning-persister/src",
     "rust-lightning:lightning-background-processor/src",
     "rust-lightning:lightning-rapid-gossip-sync/src",
     "rust-lightning:lightning-block-sync/src",
     "rust-lightning:lightning-transaction-sync/src",
     "rust-lightning:lightning-liquidity/src",
     "rust-lightning:lightning-macros/src"
    ]
   },
   "deps": {
    "spm": "bitkit:Bitkit.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved",
    "spm_engine": "ldk-node",
    "cargo": [
     {"source": "synonym-ldk-node", "args": ["--features", "uniffi"]},
     {"source": "bitkit-core", "args": []},
     {"source": "paykit-rs", "args": ["-p", "paykit-ffi"]},
     {"source": "vss-rust-client-ffi", "args": []}
    ]
   }
  },
  "Blixt": {
   "app_source": "blixt",
   "code": {
    "app": ["blixt:src", "blixt:index.js", "blixt:ios/BlixtWallet", "blixt:ios/LndMobile", "blixt:speedloader-turbomodule"],
    "lightning": ["lnd-blixt:."]
   },
   "deps": {"bun": "blixt:bun.lock", "pods": "blixt:ios/Podfile.lock", "go": {"source": "lnd-blixt"}}
  },
  "Zeus": {
   "app_source": "zeus",
   "code": {
    "app": [
     "zeus:App.tsx",
     "zeus:NavigationService.ts",
     "zeus:PushNotificationManager.tsx",
     "zeus:index.js",
     "zeus:shim.js",
     "zeus:polyfills.js",
     "zeus:backends",
     "zeus:components",
     "zeus:hooks",
     "zeus:models",
     "zeus:stores",
     "zeus:storage",
     "zeus:utils",
     "zeus:views",
     "zeus:lndmobile",
     "zeus:ldknode",
     "zeus:cashu-cdk",
     "zeus:ios/zeus",
     "zeus:ios/LndMobile",
     "zeus:ios/LdkNodeMobile",
     "zeus:ios/LncMobile",
     "zeus:ios/NWCWidget",
     "zeus:ios/ShareQR",
     "zeus:ios/CryptoHelper.swift",
     "zeus:ios/ShareBridge.h",
     "zeus:ios/ShareBridge.m",
     "zeus:ios/ZipUtils.h",
     "zeus:ios/ZipUtils.m",
     "zeus:ios/KeychainAudit.h",
     "zeus:ios/KeychainAudit.m"
    ],
    "lightning": ["lnd-zeus:."]
   },
   "deps": {
    "npm": {"package": "zeus:package.json", "yarn": "zeus:yarn.lock"},
    "pods": "zeus:ios/Podfile.lock",
    "go": {"source": "lnd-zeus"},
    "cargo": [{"source": "zeus-ldk-node", "args": ["--features", "uniffi"]}, {"source": "cdk", "args": ["-p", "cdk-ffi"]}]
   }
  }
 },
