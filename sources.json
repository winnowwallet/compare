        "lightning": ["winnow:Sources/LightningCore"]
      },
      "deps": {"spm": "winnow:Package.resolved"}
    },
    "Phoenix": {
      "app_source": "phoenix",
      "code": {
        "app": ["phoenix:phoenix-ios/phoenix-ios", "phoenix:phoenix-ios/phoenix-notifySrvExt", "phoenix:phoenix-shared/src"],
        "lightning": ["lightning-kmp:modules"]
      },
      "deps": {
        "spm": "phoenix:phoenix-ios/phoenix-ios.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved",
        "maven": {
          "target": "ios_arm64",
          "engine": "fr.acinq.lightning:lightning-kmp-core",
          "roots": [
            "fr.acinq.lightning:lightning-kmp-core:1.12.0",
            "org.jetbrains.kotlinx:kotlinx-serialization-cbor:1.9.0",
            "app.cash.sqldelight:runtime:2.1.0",
            "app.cash.sqldelight:coroutines-extensions:2.1.0",
            "co.touchlab.skie:configuration-annotations:0.10.10",
            "app.cash.sqldelight:native-driver:2.1.0"
          ]
        }
      }
    },
    "Bitkit": {
      "app_source": "bitkit",
      "code": {
        "app": ["bitkit:Bitkit", "bitkit:BitkitNotification", "bitkit:BitkitWidget"],
        "lightning": ["synonym-ldk-node:src", "rust-lightning:lightning/src", "rust-lightning:lightning-types/src",
          "rust-lightning:lightning-invoice/src", "rust-lightning:lightning-net-tokio/src", "rust-lightning:lightning-persister/src",
          "rust-lightning:lightning-background-processor/src", "rust-lightning:lightning-rapid-gossip-sync/src",
          "rust-lightning:lightning-block-sync/src", "rust-lightning:lightning-transaction-sync/src",
          "rust-lightning:lightning-liquidity/src", "rust-lightning:lightning-macros/src"]
      },
      "deps": {
        "spm": "bitkit:Bitkit.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved",
        "spm_engine": "ldk-node",
        "cargo": [
          {"source": "synonym-ldk-node", "args": ["--features", "uniffi"], "lock": "locks/synonym-ldk-node.Cargo.lock"},
          {"source": "bitkit-core", "args": []},
          {"source": "paykit-rs", "args": ["-p", "paykit-ffi"]},
          {"source": "vss-rust-client-ffi", "args": []}
        ]
      }
    },
    "Blixt": {
      "app_source": "blixt",
      "code": {
        "app": ["blixt:src", "blixt:index.js", "blixt:ios/BlixtWallet", "blixt:ios/LndMobile", "blixt:speedloader-turbomodule"],
        "lightning": ["lnd:."]
      },
      "deps": {"bun": "blixt:bun.lock", "pods": "blixt:ios/Podfile.lock", "go": true}
    },
    "Zeus": {
      "app_source": "zeus",
      "code": {
        "app": ["zeus:App.tsx", "zeus:NavigationService.ts", "zeus:PushNotificationManager.tsx", "zeus:index.js", "zeus:shim.js",
          "zeus:polyfills.js", "zeus:backends", "zeus:components", "zeus:hooks", "zeus:models", "zeus:stores", "zeus:storage",
          "zeus:utils", "zeus:views", "zeus:lndmobile", "zeus:ldknode", "zeus:cashu-cdk", "zeus:ios/zeus", "zeus:ios/LndMobile",
          "zeus:ios/LdkNodeMobile", "zeus:ios/LncMobile", "zeus:ios/NWCWidget", "zeus:ios/ShareQR", "zeus:ios/CryptoHelper.swift",
          "zeus:ios/ShareBridge.h", "zeus:ios/ShareBridge.m", "zeus:ios/ZipUtils.h", "zeus:ios/ZipUtils.m",
          "zeus:ios/KeychainAudit.h", "zeus:ios/KeychainAudit.m"],
        "lightning": ["lnd:."]
      },
      "deps": {
        "npm": {"package": "zeus:package.json", "yarn": "zeus:yarn.lock"},
        "pods": "zeus:ios/Podfile.lock",
        "go": true,
        "cargo": [
          {"source": "zeus-ldk-node", "args": ["--features", "uniffi"]},
          {"source": "cdk", "args": ["-p", "cdk-ffi"]}
        ]
      }
    }
  },
  "go": {
    "source": "lnd",
    "package": "./mobile",
    "tags": "mobile dev autopilotrpc chainrpc invoicesrpc neutrinorpc peersrpc routerrpc signrpc verrpc walletrpc watchtowerrpc wtclientrpc",
    "env": {"GOOS": "ios", "GOARCH": "arm64", "CGO_ENABLED": "1"},
    "first_party": "github.com/lightningnetwork/lnd/"
